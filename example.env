# API Keys for LLM Providers
# 각 프로바이더를 사용하려면 해당 API 키를 설정하세요.
# 이 파일을 .env로 복사한 후 실제 API 키를 입력하세요: cp example.env .env

# OpenAI API Key (필수: OpenAI 프로바이더 및 OpenAI 평가자 사용 시)
# https://platform.openai.com/api-keys 에서 발급
OPENAI_API_KEY=sk-your-openai-api-key-here

# Anthropic API Key (선택: Anthropic Claude 모델 사용 시)
# https://console.anthropic.com/ 에서 발급
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# Google API Key (선택: Gemini 모델 사용 시)
# https://aistudio.google.com/app/apikey 에서 발급
# GOOGLE_API_KEY 또는 GEMINI_API_KEY 중 하나를 사용
GOOGLE_API_KEY=your-google-api-key-here
# GEMINI_API_KEY=your-gemini-api-key-here

# OpenRouter API Key (선택: OpenRouter 프로바이더 사용 시)
# https://openrouter.ai/keys 에서 발급
OPENROUTER_API_KEY=your-openrouter-api-key-here

# vLLM Configuration (선택: 자체 호스팅 vLLM 서버 사용 시)
# vLLM 서버 API 엔드포인트
VLLM_API_BASE=http://localhost:8000/v1
# vLLM 모델 이름
VLLM_MODEL_NAME=your-model-name
# vLLM API Key (대부분의 경우 불필요, 기본값: EMPTY)
VLLM_API_KEY=EMPTY

